generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum UserRole {
  ADMIN
  MECHANIC
  ATTENDANT
}

enum ServiceOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELED
}

model Customer {
  id        String       @id @default(uuid())
  name      String
  document  String       @unique
  type      CustomerType
  email     String
  phone     String
  address   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]

  @@map("customers")
}

model Vehicle {
  id           String   @id @default(uuid())
  customerId   String
  licensePlate String   @unique
  brand        String
  model        String
  year         Int
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id                       String   @id @default(uuid())
  name                     String
  description              String?
  price                    Decimal  @db.Decimal(10, 2)
  estimatedDurationMinutes Int
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  serviceOrderServices ServiceOrderService[]

  @@map("services")
}

model Part {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  stockQuantity    Int      @default(0)
  minStockQuantity Int      @default(10)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceOrderParts ServiceOrderPart[]

  @@map("parts")
}

model ServiceOrder {
  id                 String             @id @default(uuid())
  orderNumber        String             @unique
  customerId         String
  vehicleId          String
  problemDescription String
  status             ServiceOrderStatus @default(RECEIVED)
  // Agregado mantido na própria ordem: é a soma das duas tabelas filhas, mas
  // também é o valor que o cliente aprovou. Recalculá-lo a cada leitura faria
  // o total exibido mudar sozinho se o catálogo mudasse, e custaria um join
  // com agregação em toda listagem.
  totalAmount        Decimal            @default(0) @db.Decimal(10, 2)
  notes              String?
  approvedAt         DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer Customer              @relation(fields: [customerId], references: [id])
  vehicle  Vehicle               @relation(fields: [vehicleId], references: [id])
  services ServiceOrderService[]
  parts    ServiceOrderPart[]

  // O Postgres não cria índice em coluna de chave estrangeira automaticamente.
  @@index([customerId])
  @@index([vehicleId])
  // Cobre tanto o filtro só por status quanto a ordenação por data dentro de
  // cada status, que é como a listagem principal pagina.
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("service_orders")
}

// Serviços de uma ordem. Antes era um campo Json, o que impedia integridade
// referencial com o catálogo e qualquer consulta analítica sobre os itens.
model ServiceOrderService {
  id             String   @id @default(uuid())
  serviceOrderId String
  serviceId      String
  // serviceName e price são cópias do catálogo no momento em que o item foi
  // adicionado, de propósito: reajustar o preço de um serviço não pode alterar
  // o valor de uma ordem que já foi orçada.
  serviceName    String
  price          Decimal  @db.Decimal(10, 2)
  quantity       Int
  notes          String?
  // Preserva a ordem em que os itens foram adicionados. Sem isto a ordem de
  // leitura fica indefinida, e a resposta da API mudaria entre requisições.
  position       Int
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([serviceOrderId, position])
  @@index([serviceOrderId])
  @@index([serviceId])
  @@map("service_order_services")
}

// Peças de uma ordem. Mesma motivação da tabela de serviços.
model ServiceOrderPart {
  id             String   @id @default(uuid())
  serviceOrderId String
  partId         String
  // Cópias do catálogo no momento da inclusão, pelo mesmo motivo dos serviços.
  partName       String
  partCode       String
  unitPrice      Decimal  @db.Decimal(10, 2)
  quantity       Int
  // totalPrice não existe como coluna: era unitPrice * quantity, duas colunas
  // da mesma linha. Guardar o produto abre espaço para os três valores se
  // contradizerem. É calculado na leitura.
  position       Int
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id])

  @@unique([serviceOrderId, position])
  @@index([serviceOrderId])
  @@index([partId])
  @@map("service_order_parts")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Usado pela limpeza periódica de tokens vencidos.
  @@index([expiresAt])
  @@map("refresh_tokens")
}
